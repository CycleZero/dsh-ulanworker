{
  "name": "dsh-ulanworker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh-ulanworker — a Sisyphus agent preset for DeepSeek Harness: a faithful port of OhMyOpenCode's default Sisyphus orchestrator prompt with DSH-native tools, a role-dispatching subagent tool (oracle, explore, librarian, metis, momus, plan, looker, atlas), and the ultrawork and handoff skills bundled as /ultrawork and /handoff.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "agent-preset",
    "sisyphus"
  ],
  "exports": {
    ".": "./index.js",
    "./yaml-lite": "./yaml-lite.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./prompts/*": "./prompts/*",
    "./skills/*": "./skills/*",
    "./roles/*": "./roles/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./smoke": "./smoke.mjs",
    "./smoke-probe": "./smoke-probe.mjs"
  },
  "files": [
    "index.js",
    "subagent.js",
    "yaml-lite.js",
    "cordis.patch.yml",
    "prompts/",
    "skills/",
    "roles/",
    "locale/*.json",
    "NOTICE.md",
    "smoke.mjs",
    "smoke-probe.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && node verify.mjs",
    "smoke": "node smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
